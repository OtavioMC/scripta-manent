{
  "name": "otaviomc/scripta-manent",
  "description": "Cadastro de livros, autores e assuntos, com relatório agrupado por autor.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.4.0",
    "laminas/laminas-httphandlerrunner": "2.14.0",
    "nikic/fast-route": "1.3.1",
    "nyholm/psr7": "1.8.2",
    "nyholm/psr7-server": "1.1.0",
    "predis/predis": "3.7.0",
    "psr/http-factory": "1.1.0",
    "psr/http-message": "2.0",
    "psr/http-server-handler": "1.0.2",
    "psr/http-server-middleware": "1.0.2",
    "psr/log": "3.0.2",
    "twbs/bootstrap": "5.3.8",
    "twig/twig": "3.30.0"
  },
  "require-dev": {
    "captainhook/captainhook": "5.29.2",
    "captainhook/hook-installer": "1.0.5",
    "deptrac/deptrac": "4.7.2",
    "phpstan/phpstan": "2.3.5",
    "phpunit/phpunit": "13.4.6",
    "squizlabs/php_codesniffer": "4.0.4"
  },
  "autoload": {
    "psr-4": {
      "ScriptaManent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ScriptaManent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analise": "phpstan analyse --memory-limit=512M",
    "camadas": "deptrac analyse --no-progress",
    "estilo": "phpcs",
    "sintaxe": "find config public src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "testes": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.4.27"
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "captainhook/hook-installer": true
    }
  }
}
