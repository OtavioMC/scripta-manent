{% extends 'base.html.twig' %}

{% block menu_ativo %}/relatorio{% endblock %}

{% import 'macros/busca.html.twig' as busca_ %}

{% block colecao %}relatorio{% endblock %}

{% block titulo %}Relatório{% endblock %}

{% block conteudo %}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="titulo-secao mb-1">Relatório de livros por autor</h1>
            <p class="texto-suave mb-0">Gerado em {{ geradoEm }}, horário de Brasília.</p>
        </div>
        {% if pdfLigado %}
            <a class="btn btn-destaque" href="/relatorio/pdf{{ busca ? '?busca=' ~ busca|url_encode }}"
               data-mantem-busca="/relatorio/pdf">Baixar PDF</a>
        {% else %}
            <div class="text-sm-end">
                <button class="btn btn-destaque" type="button" disabled aria-describedby="pdf-desligado">Baixar PDF</button>
                <p class="form-text mb-0" id="pdf-desligado">O PDF não está disponível neste ambiente. A prévia abaixo tem os mesmos dados.</p>
            </div>
        {% endif %}
    </div>

    {% if aviso %}
        <div class="alert alert-warning" role="status">{{ aviso }}</div>
    {% endif %}

    {{ busca_.campo('/relatorio', busca, 'Buscar no relatório', 'Buscar por título, autor, assunto ou editora') }}

    <div data-resultados>
        {{ busca_.situacao('/relatorio', busca, relatorio.totalDeLivros, 'livro encontrado', 'livros encontrados') }}
        {% include 'relatorio/_conteudo.html.twig' %}
    </div>
{% endblock %}

{% block scripts %}
    <script type="module" src="/assets/js/busca-instantanea.js"></script>
{% endblock %}
