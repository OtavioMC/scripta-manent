{% set menuAtivo = block('menu_ativo') is defined ? block('menu_ativo')|trim : '' %}
{% set colecao = block('colecao') is defined ? block('colecao')|trim : '' %}
{% set versaoDaColecao = colecao ? versaoDe(colecao) : null %}
{% set avisosDeAlteracao = {
    livros: 'A lista de livros mudou desde que você abriu esta página.',
    autores: 'A lista de autores mudou desde que você abriu esta página.',
    assuntos: 'A lista de assuntos mudou desde que você abriu esta página.',
    relatorio: 'Os dados do relatório mudaram desde que você abriu esta página.'
} %}
<!doctype html>
<html lang="pt-BR" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#7f1d1d">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <title>{% block titulo %}{% endblock %} | Scripta Manent</title>
    <script src="/assets/js/aplicar-tema.js"></script>
    <link rel="stylesheet" href="/assets/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/aplicacao.css">
</head>
<body>
    <a class="visually-hidden-focusable" href="#conteudo">Pular para o conteúdo</a>

    <nav class="navbar navbar-expand-md navbar-aplicacao sticky-top" aria-label="Menu principal">
        <div class="container">
            <a class="navbar-brand marca" href="/">Scripta Manent</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Abrir o menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    {% for item in menu %}
                        <li class="nav-item">
                            {% if item.endereco == menuAtivo %}
                                <a class="nav-link active" aria-current="page" href="{{ item.endereco }}">{{ item.rotulo }}</a>
                            {% else %}
                                <a class="nav-link" href="{{ item.endereco }}">{{ item.rotulo }}</a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <p class="navbar-text proverbio d-md-none d-lg-block mb-0 me-lg-4" lang="la">
                    <span class="proverbio-latim">“Verba volant, scripta manent”</span>
                    <span class="proverbio-traducao" lang="pt-BR">As palavras voam, os escritos permanecem.</span>
                </p>
                <div class="d-flex gap-2 my-2 my-md-0">
                    <button class="btn btn-outline-secondary btn-sm rounded-pill" type="button"
                            id="alternar-tema">Tema escuro</button>
                    <form method="post" action="/sair">
                        {{ csrf.campo|raw }}
                        <button class="btn btn-outline-secondary btn-sm rounded-pill" type="submit">Sair</button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <main id="conteudo">
        {% block faixa %}{% endblock %}
        <div class="container py-4 py-lg-5">
            {% block conteudo %}{% endblock %}
        </div>
        {% block faixa_final %}{% endblock %}
    </main>

    {% if versaoDaColecao is not null %}
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div class="toast" id="aviso-de-alteracao" role="status" aria-live="polite" aria-atomic="true"
                 data-colecao="{{ colecao }}" data-versao="{{ versaoDaColecao }}">
                <div class="toast-body">
                    <p class="mb-2">{{ avisosDeAlteracao[colecao] }}</p>
                    <button class="btn btn-sm btn-destaque" type="button" data-atualizar>Atualizar</button>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-dismiss="toast">Fechar</button>
                </div>
            </div>
        </div>
    {% endif %}

    <script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/assets/js/alternar-tema.js"></script>
    {% if versaoDaColecao is not null %}
        <script type="module" src="/assets/js/avisar-alteracao.js"></script>
    {% endif %}
    {% block scripts %}{% endblock %}
</body>
</html>
