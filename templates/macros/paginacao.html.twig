{% macro endereco(acao, busca, numero) %}{{ acao }}?{{ (busca ? {busca: busca} : {})|merge({pagina: numero})|url_encode }}{% endmacro %}

{% macro navegacao(acao, busca, lista, plural) %}
    {% if lista.quantidadeDePaginas > 1 %}
        <nav class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mt-3"
             aria-label="Páginas da lista de {{ plural }}">
            <p class="texto-suave mb-0">
                Mostrando {{ lista.primeiroItemExibido }} a {{ lista.ultimoItemExibido }} de {{ lista.totalDeItens }} {{ plural }}.
            </p>
            <ul class="pagination paginacao mb-0">
                {% if lista.paginaAnterior is null %}
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">&lsaquo;</span></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ _self.endereco(acao, busca, lista.paginaAnterior) }}" rel="prev"
                           aria-label="Página anterior"><span aria-hidden="true">&lsaquo;</span></a>
                    </li>
                {% endif %}
                {% for numero in lista.paginasNaNavegacao %}
                    {% if numero is null %}
                        <li class="page-item disabled"><span class="page-link" aria-hidden="true">&hellip;</span></li>
                    {% elseif numero == lista.pagina.numero %}
                        <li class="page-item active" aria-current="page"><span class="page-link">{{ numero }}</span></li>
                    {% else %}
                        <li class="page-item">
                            <a class="page-link" href="{{ _self.endereco(acao, busca, numero) }}"
                               aria-label="Página {{ numero }}">{{ numero }}</a>
                        </li>
                    {% endif %}
                {% endfor %}
                {% if lista.proximaPagina is null %}
                    <li class="page-item disabled"><span class="page-link" aria-hidden="true">&rsaquo;</span></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ _self.endereco(acao, busca, lista.proximaPagina) }}" rel="next"
                           aria-label="Próxima página"><span aria-hidden="true">&rsaquo;</span></a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endmacro %}
