{% extends 'base.html.twig' %}

{% block titulo %}{{ editando ? 'Editar assunto' : 'Cadastrar assunto' }}{% endblock %}

{% block conteudo %}
    <nav aria-label="Caminho">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/assuntos">Assuntos</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ editando ? 'Editar' : 'Cadastrar' }}</li>
        </ol>
    </nav>

    <h1 class="titulo-secao mb-4">{{ editando ? 'Editar assunto' : 'Cadastrar assunto' }}</h1>

    <div class="cartao-formulario">
        {% include 'assuntos/_formulario.html.twig' with {emModal: false} %}
    </div>
{% endblock %}

{% block scripts %}
    <script type="module" src="/assets/js/validar-formulario.js"></script>
{% endblock %}
