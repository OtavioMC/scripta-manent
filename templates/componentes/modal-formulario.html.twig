<div class="modal fade" id="modal-formulario" tabindex="-1" aria-labelledby="titulo-modal-formulario" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down {{ tamanho ?? '' }}">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="titulo-modal-formulario">{{ titulo }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {% block corpo %}{% endblock %}
            </div>
        </div>
    </div>
</div>
